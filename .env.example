# Public values below are exposed in the browser bundle. Use public credentials only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_ENABLE_DAILY_EDIT_SETTINGS="false"

# Server-side Supabase credentials (same values as VITE_* above).
# Required on Vercel / serverless: VITE_* vars are stripped from serverless functions.
# Set BOTH pairs in your Vercel project env: VITE_SUPABASE_URL for the browser AND
# SUPABASE_URL for the /api routes so they can read published CMS content too.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# Public application URL and server listener.
APP_URL="http://localhost:3000"
PORT="3000"
HOST="0.0.0.0"
NODE_ENV="development"

# PostgreSQL connection for persistent publishing and newsletter subscriptions.
# Newsletter digests cannot be delivered without this in production.
# When Supabase credentials above are set, published articles are read from Supabase
# instead of Postgres; DATABASE_URL is still needed for newsletter preferences/digests.
DATABASE_URL=""

# Email & Resend mailer settings for Contact Us form & alerts
# Get your free API key at https://resend.com
RESEND_API_KEY=""
# Verified sender from your domain, or test with onboarding@resend.dev
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="NexTake Desk"
# Where contact form messages should be delivered:
CONTACT_RECIPIENT_EMAIL="martins.me1@proton.me"
# Secret used to authorize Vercel's scheduled daily newsletter digest.
CRON_SECRET=""
ADMIN_EMAIL="martins.me1@proton.me"
ADMIN_USERNAME="Glint"
SESSION_SECRET="replace-with-a-strong-random-secret"