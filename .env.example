# Public values below are exposed in the browser bundle. Use public credentials only.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_ENABLE_DAILY_EDIT_SETTINGS="false"

# Public application URL and server listener. Vite proxies /api to PORT.
APP_URL="http://localhost:4100"
PORT="4101"
HOST="0.0.0.0"
NODE_ENV="development"

# Optional PostgreSQL connection. The server uses in-memory storage when omitted.
DATABASE_URL=""

# Email & Resend mailer settings for Contact Us form & alerts
# Get your free API key at https://resend.com
RESEND_API_KEY=""
# Verified sender from your domain, or test with onboarding@resend.dev
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="NexTake Desk"
# Where contact form messages should be delivered:
CONTACT_RECIPIENT_EMAIL="martins.me1@proton.me"
ADMIN_EMAIL="martins.me1@proton.me"
ADMIN_USERNAME="Glint"
SESSION_SECRET="replace-with-a-strong-random-secret"