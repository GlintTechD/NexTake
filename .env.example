# Gemini API key is injected by AI Studio when Gemini is used.
GEMINI_API_KEY=""

# Public values below are exposed in the browser bundle. Use public credentials only.
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_ENABLE_DAILY_EDIT_SETTINGS="false"

# Public application URL and server listener. Vite proxies /api to PORT.
APP_URL="http://localhost:4100"
PORT="4101"
HOST="0.0.0.0"
NODE_ENV="development"

# Optional PostgreSQL connection. The server uses in-memory storage when omitted.
DATABASE_URL=""

# Optional admin authentication and OTP email settings.
ADMIN_USERNAME="Glint"
ADMIN_EMAIL="martins.me1@proton.me"
SESSION_SECRET="replace-with-a-strong-random-secret"
RESEND_API_KEY=""
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="NexTake Admin"
  