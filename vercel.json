{
  "crons": [
    {
      "path": "/api/cron/newsletter-digest",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/article/:path*", "destination": "/index.html" },
    { "source": "/startup/:path*", "destination": "/index.html" },
    { "source": "/latest", "destination": "/index.html" },
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/shorts", "destination": "/index.html" },
    { "source": "/interview", "destination": "/index.html" },
    { "source": "/startups", "destination": "/index.html" },
    { "source": "/events", "destination": "/index.html" }
  ]
}
